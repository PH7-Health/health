generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LifeStatus {
  ON_TRACK
  WATCH
  AT_RISK
  OFF_TRACK
}

enum MetricValueType {
  NUMBER
  INTEGER
  DECIMAL
  DURATION
  BOOLEAN
  SCALE_1_10
  SELECT
  TEXT
}

enum CompletionState {
  COMPLETED
  PARTIAL
  SKIPPED
  MISSED
}

enum TaskPriority {
  MOST_IMPORTANT
  CRITICAL
  SECONDARY
  OPTIONAL
}

enum AlertSeverity {
  INFO
  WATCH
  AT_RISK
  OFF_TRACK
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

enum ConfirmationStatus {
  AUTO_ACCEPTED
  NEEDS_CONFIRMATION
  CONFIRMED
  REJECTED
  ERROR
}

enum EmailMutationStatus {
  PROPOSED
  APPLIED
  REJECTED
  FAILED
}

enum PathwayStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum MilestoneStatus {
  PENDING
  ACTIVE
  COMPLETED
  SKIPPED
}

enum TrajectoryStatus {
  AHEAD
  ON_TRACK
  WATCH
  BEHIND
  STALLED
  INSUFFICIENT_DATA
}

enum IntelligenceConfidence {
  HIGH
  MEDIUM
  LOW
  INSUFFICIENT_DATA
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DISMISSED
  SUPERSEDED
}

enum InsightType {
  TREND
  PROGRESS
  STALL
  COMPLIANCE
  IMBALANCE
  NEGLECT
  MILESTONE
  DATA_QUALITY
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  name                    String?
  lifeAreas               LifeArea[]
  objectives              Objective[]
  keyResults              KeyResult[]
  metricDefinitions       MetricDefinition[]
  metricEntries           MetricEntry[]
  habits                  Habit[]
  habitCompletions        HabitCompletion[]
  supplements             Supplement[]
  supplementLogs          SupplementLog[]
  tasks                   Task[]
  taskCompletions         TaskCompletion[]
  dailyCheckIns           DailyCheckIn[]
  dailyScores             DailyScore[]
  weeklyReviews           WeeklyReview[]
  alertRules              AlertRule[]
  alertEvents             AlertEvent[]
  notificationPreferences NotificationPreference[]
  emailMessages           EmailMessage[]
  emailParsedEntries      EmailParsedEntry[]
  emailMutations          EmailMutation[]
  settings                UserSetting[]
  pathways                GoalPathway[]
  trajectorySnapshots     TrajectorySnapshot[]
  insights                Insight[]
  recommendations         Recommendation[]
  aiProposals             AIProposal[]
  aiExecutions            AIExecution[]
  pathwayMetrics          PathwayMetric[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model LifeArea {
  id          String      @id @default(cuid())
  userId      String
  key         String
  name        String
  description String?
  weight      Int         @default(0)
  sortOrder   Int         @default(0)
  active      Boolean     @default(true)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectives  Objective[]
  habits      Habit[]
  tasks       Task[]

  @@unique([userId, key])
  @@index([userId, active, sortOrder])
}

model GoalPathway {
  id                  String                 @id @default(cuid())
  userId              String
  objectiveId         String                 @unique
  currentDescription  String
  desiredDescription  String
  constraints         String?
  preferences         String?
  baselineValue       Float?
  targetValue         Float?
  unit                String?
  direction           String                 @default("INCREASE")
  baselineDate        DateTime?              @db.Date
  desiredDate         DateTime?              @db.Date
  status              PathwayStatus          @default(DRAFT)
  trajectoryStatus    TrajectoryStatus       @default(INSUFFICIENT_DATA)
  confidence          IntelligenceConfidence @default(INSUFFICIENT_DATA)
  limiterTitle        String?
  limiterExplanation  String?
  limiterConfidence   IntelligenceConfidence @default(INSUFFICIENT_DATA)
  lastRecalculatedAt  DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  objective           Objective              @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  milestones          Milestone[]
  actions             PathwayAction[]
  revisions           PathwayRevision[]
  trajectorySnapshots TrajectorySnapshot[]
  insights            Insight[]
  recommendations     Recommendation[]
  proposals           AIProposal[]
  metrics             PathwayMetric[]

  @@index([userId, status])
}

model Milestone {
  id          String          @id @default(cuid())
  pathwayId   String
  sequence    Int
  title       String
  description String?
  targetValue Float?
  unit        String?
  status      MilestoneStatus @default(PENDING)
  targetDate  DateTime?       @db.Date
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  pathway     GoalPathway     @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  @@unique([pathwayId, sequence])
}

model PathwayMetric {
  id                 String           @id @default(cuid())
  pathwayId          String
  metricDefinitionId String
  role               String           @default("PRIMARY")
  rationale          String
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  pathway            GoalPathway      @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  metricDefinition   MetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)
  user               User?            @relation(fields: [userId], references: [id])
  userId             String?

  @@unique([pathwayId, metricDefinitionId])
  @@index([metricDefinitionId, active])
}

model PathwayAction {
  id               String      @id @default(cuid())
  pathwayId        String
  taskId           String?
  title            String
  rationale        String
  expectedImpact   String?
  priority         Int         @default(3)
  requiresApproval Boolean     @default(false)
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  pathway          GoalPathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  task             Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([pathwayId, active, priority])
}

model PathwayRevision {
  id        String      @id @default(cuid())
  pathwayId String
  reason    String
  snapshot  Json
  createdAt DateTime    @default(now())
  pathway   GoalPathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
}

model TrajectorySnapshot {
  id               String                 @id @default(cuid())
  userId           String
  pathwayId        String
  localDate        DateTime               @db.Date
  progressPercent  Float?
  velocity         Float?
  estimateLowDate  DateTime?              @db.Date
  estimateHighDate DateTime?              @db.Date
  status           TrajectoryStatus
  confidence       IntelligenceConfidence
  basis            String
  snapshot         Json
  createdAt        DateTime               @default(now())
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathway          GoalPathway            @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  @@unique([pathwayId, localDate])
}

model Insight {
  id              String                 @id @default(cuid())
  userId          String
  pathwayId       String?
  type            InsightType
  fingerprint     String
  title           String
  explanation     String
  evidence        Json
  confidence      IntelligenceConfidence
  dataWindowStart DateTime?              @db.Date
  dataWindowEnd   DateTime?              @db.Date
  createdAt       DateTime               @default(now())
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathway         GoalPathway?           @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
}

model Recommendation {
  id               String                 @id @default(cuid())
  userId           String
  pathwayId        String?
  fingerprint      String
  title            String
  explanation      String
  expectedImpact   String?
  confidence       IntelligenceConfidence
  requiresApproval Boolean                @default(false)
  active           Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathway          GoalPathway?           @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
}

model AIProposal {
  id            String                 @id @default(cuid())
  userId        String
  pathwayId     String?
  type          String
  title         String
  rationale     String
  payload       Json
  status        ProposalStatus         @default(PENDING)
  provider      String
  model         String?
  schemaVersion String
  confidence    IntelligenceConfidence
  dataWindow    Json?
  generatedAt   DateTime               @default(now())
  resolvedAt    DateTime?
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathway       GoalPathway?           @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model AIExecution {
  id            String   @id @default(cuid())
  userId        String
  provider      String
  model         String?
  operation     String
  schemaVersion String
  inputWindow   Json
  output        Json?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Objective {
  id          String       @id @default(cuid())
  userId      String
  lifeAreaId  String
  title       String
  description String?
  status      LifeStatus   @default(ON_TRACK)
  priority    Int          @default(3)
  dueDate     DateTime?
  active      Boolean      @default(true)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifeArea    LifeArea     @relation(fields: [lifeAreaId], references: [id], onDelete: Cascade)
  keyResults  KeyResult[]
  habits      Habit[]
  tasks       Task[]
  pathway     GoalPathway?

  @@index([userId, lifeAreaId, active])
}

model KeyResult {
  id                 String            @id @default(cuid())
  userId             String
  objectiveId        String
  title              String
  description        String?
  metricDefinitionId String?
  baseline           Float?
  target             Float?
  currentValue       Float?
  unit               String?
  targetDirection    String            @default("INCREASE")
  currentValueSource String            @default("manual")
  dueDate            DateTime?
  qualitative        Boolean           @default(false)
  status             LifeStatus        @default(ON_TRACK)
  active             Boolean           @default(true)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  objective          Objective         @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  metricDefinition   MetricDefinition? @relation(fields: [metricDefinitionId], references: [id], onDelete: SetNull)

  @@index([userId, objectiveId])
}

model MetricDefinition {
  id               String          @id @default(cuid())
  userId           String
  key              String
  name             String
  description      String?
  valueType        MetricValueType
  unit             String?
  category         String
  defaultTarget    Float?
  targetMin        Float?
  targetMax        Float?
  targetDirection  String          @default("NONE")
  frequency        String          @default("DAILY")
  decimalPrecision Int             @default(0)
  showInCheckIn    Boolean         @default(true)
  showInDashboard  Boolean         @default(true)
  useInDrift       Boolean         @default(false)
  useInScore       Boolean         @default(false)
  selectOptions    Json?
  important        Boolean         @default(false)
  active           Boolean         @default(true)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries          MetricEntry[]
  keyResults       KeyResult[]
  pathwayMetrics   PathwayMetric[]

  @@unique([userId, key])
  @@index([userId, active])
}

model MetricEntry {
  id                 String           @id @default(cuid())
  userId             String
  metricDefinitionId String
  localDate          DateTime         @db.Date
  valueNumber        Float?
  valueText          String?
  valueBoolean       Boolean?
  source             String           @default("manual")
  note               String?
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  metricDefinition   MetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)

  @@unique([userId, metricDefinitionId, localDate])
  @@index([userId, localDate])
}

model Habit {
  id                  String            @id @default(cuid())
  userId              String
  lifeAreaId          String
  objectiveId         String?
  key                 String
  name                String
  targetCount         Int               @default(1)
  targetPeriod        String            @default("day")
  scoreWeight         Float             @default(1)
  frequency           String            @default("DAILY")
  showToday           Boolean           @default(true)
  affectsScore        Boolean           @default(true)
  participatesInDrift Boolean           @default(false)
  notes               String?
  active              Boolean           @default(true)
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifeArea            LifeArea          @relation(fields: [lifeAreaId], references: [id], onDelete: Cascade)
  objective           Objective?        @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  schedules           HabitSchedule[]
  completions         HabitCompletion[]

  @@unique([userId, key])
}

model HabitSchedule {
  id         String @id @default(cuid())
  habitId    String
  daysOfWeek Json?
  habit      Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
}

model HabitCompletion {
  id        String          @id @default(cuid())
  userId    String
  habitId   String
  localDate DateTime        @db.Date
  state     CompletionState @default(COMPLETED)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit     Habit           @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([userId, habitId, localDate])
}

model Supplement {
  id           String               @id @default(cuid())
  userId       String
  name         String
  intendedDose Float?
  doseUnit     String?
  normalTime   String?
  frequency    String               @default("DAILY")
  startDate    DateTime?            @db.Date
  endDate      DateTime?            @db.Date
  notes        String?
  active       Boolean              @default(true)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules    SupplementSchedule[]
  logs         SupplementLog[]
}

model SupplementSchedule {
  id           String     @id @default(cuid())
  supplementId String
  daysOfWeek   Json?
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)
}

model SupplementLog {
  id                    String          @id @default(cuid())
  userId                String
  supplementId          String
  localDate             DateTime        @db.Date
  state                 CompletionState @default(COMPLETED)
  configurationSnapshot Json?
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplement            Supplement      @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  @@unique([userId, supplementId, localDate])
}

model Task {
  id              String           @id @default(cuid())
  userId          String
  lifeAreaId      String?
  objectiveId     String?
  title           String
  priority        TaskPriority     @default(SECONDARY)
  dueDate         DateTime?        @db.Date
  showToday       Boolean          @default(true)
  scoreRelevant   Boolean          @default(true)
  targetFrequency Int              @default(1)
  active          Boolean          @default(true)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifeArea        LifeArea?        @relation(fields: [lifeAreaId], references: [id], onDelete: SetNull)
  objective       Objective?       @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  recurrenceRule  RecurrenceRule?
  completions     TaskCompletion[]
  pathwayActions  PathwayAction[]

  @@index([userId, active])
}

model RecurrenceRule {
  id         String @id @default(cuid())
  taskId     String @unique
  frequency  String @default("DAILY")
  daysOfWeek Json?
  task       Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskCompletion {
  id        String          @id @default(cuid())
  userId    String
  taskId    String
  localDate DateTime        @db.Date
  state     CompletionState @default(COMPLETED)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, localDate])
}

model DailyCheckIn {
  id          String    @id @default(cuid())
  userId      String
  localDate   DateTime  @db.Date
  timezone    String
  reflection  String?
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
}

model DailyScore {
  id               String                @id @default(cuid())
  userId           String
  localDate        DateTime              @db.Date
  score            Int
  status           LifeStatus
  summary          String
  algorithmVersion String                @default("v1")
  snapshot         Json
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  components       DailyScoreComponent[]

  @@unique([userId, localDate])
}

model DailyScoreComponent {
  id           String     @id @default(cuid())
  dailyScoreId String
  label        String
  expected     Int
  completed    Int
  weight       Float
  contribution Float
  details      Json?
  dailyScore   DailyScore @relation(fields: [dailyScoreId], references: [id], onDelete: Cascade)
}

model WeeklyReview {
  id              String   @id @default(cuid())
  userId          String
  weekStart       DateTime @db.Date
  weekEnd         DateTime @db.Date
  overallScore    Int
  strongestArea   String?
  weakestArea     String?
  improved        Json
  deteriorated    Json
  neglected       Json
  recommendations Json
  reflection      String?
  snapshot        Json
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

model AlertRule {
  id       String        @id @default(cuid())
  userId   String
  key      String
  name     String
  severity AlertSeverity @default(WATCH)
  config   Json
  active   Boolean       @default(true)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events   AlertEvent[]

  @@unique([userId, key])
}

model AlertEvent {
  id                String     @id @default(cuid())
  userId            String
  alertRuleId       String?
  localDate         DateTime   @db.Date
  status            LifeStatus
  title             String
  explanation       String
  expectedValue     String
  observedValue     String
  period            String
  recommendedAction String
  fingerprint       String
  resolvedAt        DateTime?
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertRule         AlertRule? @relation(fields: [alertRuleId], references: [id], onDelete: SetNull)

  @@unique([userId, fingerprint, localDate])
}

model NotificationPreference {
  id          String        @id @default(cuid())
  userId      String
  channel     String
  eventType   String
  enabled     Boolean       @default(true)
  minSeverity AlertSeverity @default(WATCH)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, eventType])
}

model EmailMessage {
  id                 String             @id @default(cuid())
  userId             String
  direction          EmailDirection
  messageType        String
  subject            String
  bodyText           String
  sender             String?
  recipient          String?
  provider           String?
  providerMessageId  String?
  triggerFingerprint String?
  suppressed         Boolean            @default(false)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parsedEntries      EmailParsedEntry[]
  mutations          EmailMutation[]
  createdAt          DateTime           @default(now())
}

model EmailParsedEntry {
  id                 String             @id @default(cuid())
  userId             String
  emailMessageId     String
  fieldKey           String
  rawValue           String
  parsedValue        Json
  confidence         Float
  confirmationStatus ConfirmationStatus @default(NEEDS_CONFIRMATION)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailMessage       EmailMessage       @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
}

model EmailMutation {
  id             String              @id @default(cuid())
  userId         String
  emailMessageId String
  targetModel    String
  operation      String
  payload        Json
  status         EmailMutationStatus @default(PROPOSED)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailMessage   EmailMessage        @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
}

model UserSetting {
  id     String @id @default(cuid())
  userId String
  key    String
  value  Json
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}
